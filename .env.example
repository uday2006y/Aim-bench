# AIMBENCH local environment. Copy to .env.local and fill in. This example file is safe to commit.
# Same variables must be set in Vercel -> Settings -> Environment Variables.

# --- Supabase (Dashboard -> Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=""
# Secret / service-role key. Server only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# --- Session signing (>= 32 chars; rotating signs everyone out) ---
SESSION_SECRET=""

# --- Vercel cron auth for /api/easyaim/sync-all (Vercel sends it as a Bearer token) ---
CRON_SECRET=""

# --- EasyAim ---
EASYAIM_API_URL=""
EASYAIM_API_KEY=""

# --- Discord OAuth (Developer Portal -> your app -> OAuth2) ---
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
